msgstr "Nieprawidłowa nazwa użytkownika lub hasło"

#: app.py
msgid "Invalid request"
msgstr "Nieprawidłowe żądanie"

#: app.py
msgid "Logged out successfully"
msgstr "Wylogowano"

#: app.py
