#: templates/_composer_strings.html
msgid "Choose a file to send."
msgstr "Wybierz plik do wysłania."

#: templates/_composer_strings.html
msgid "Write the note you want to send."
msgstr "Napisz notatkę, którą chcesz wysłać."

#: templates/_composer_strings.html
msgid "Network error while sending the drop. Please try again."
msgstr "Błąd sieci podczas wysyłania przesyłki. Spróbuj ponownie."

#: templates/_composer_strings.html
msgid "The drop is too large to send."
msgstr "Przesyłka jest za duża, żeby ją wysłać."

#: templates/_composer_strings.html
msgid "That file type is not allowed."
msgstr "Ten typ pliku jest niedozwolony."

#: templates/_composer_strings.html
msgid "Your session has expired. Reload the page and try again."
msgstr "Sesja wygasła. Odśwież stronę i spróbuj ponownie."

#: templates/_composer_strings.html
msgid "Choose a valid expiry time."
msgstr "Wybierz poprawny termin ważności."

#: templates/_composer_strings.html
msgid "Open notifications are not configured on this server."
msgstr "Powiadomienia o otwarciu nie są skonfigurowane na tym serwerze."

#: templates/_composer_strings.html
msgid "Configure an account email before enabling open notifications."
msgstr "Zanim włączysz powiadomienia o otwarciu, ustaw adres e-mail konta."

#: templates/_composer_strings.html
msgid "Your configured account email is invalid."
msgstr "Adres e-mail ustawiony na koncie jest nieprawidłowy."

#: templates/_composer_strings.html
msgid "Open notifications can only be sent to your configured account email."
msgstr ""
"Powiadomienia o otwarciu można wysyłać tylko na adres e-mail ustawiony na"
" koncie."

#: templates/_composer_strings.html
msgid "The server would not accept the drop. Please try again."
msgstr "Serwer nie przyjął przesyłki. Spróbuj ponownie."

#: templates/_composer_strings.html
msgid "Could not send the drop. Please try again."
msgstr "Nie udało się wysłać przesyłki. Spróbuj ponownie."

#: templates/_composer_strings.html
msgid "The drop may have been sent, but the server's reply could not be read."
msgstr ""
"Przesyłka mogła zostać wysłana, ale nie udało się odczytać odpowiedzi "
"serwera."

