msgid "Drop link copied to clipboard."
msgstr "Skopiowano do schowka link do przesyłki."

#: templates/_clipboard_feedback_strings.html
msgid "Your browser blocked clipboard access, so the drop link was not copied."
msgstr ""
"Przeglądarka zablokowała dostęp do schowka, więc nie skopiowano linku do "
"przesyłki."

#: templates/_clipboard_feedback_strings.html
msgid "One-click link copied to clipboard."
msgstr "Skopiowano link z hasłem do schowka."

#: templates/_clipboard_feedback_strings.html
msgid ""
"Your browser blocked clipboard access, so the one-click link was not "
"copied."
msgstr ""
"Przeglądarka zablokowała dostęp do schowka, więc nie skopiowano linku z "
"hasłem."

#: templates/_clipboard_feedback_strings.html
msgid "Password copied to clipboard."
msgstr "Skopiowano hasło do schowka."

#: templates/_clipboard_feedback_strings.html
msgid "Your browser blocked clipboard access, so the password was not copied."
msgstr "Przeglądarka zablokowała dostęp do schowka, więc nie skopiowano hasła."

#: templates/_clipboard_feedback_strings.html
msgid "Token copied to clipboard."
msgstr "Skopiowano token do schowka."

#: templates/_clipboard_feedback_strings.html
msgid "Your browser blocked clipboard access, so the token was not copied."
msgstr "Przeglądarka zablokowała dostęp do schowka, więc nie skopiowano tokenu."

#: templates/_clipboard_feedback_strings.html
msgid "Text copied to clipboard."
msgstr "Skopiowano tekst do schowka."

#: templates/_clipboard_feedback_strings.html
msgid "Your browser blocked clipboard access, so the text was not copied."
msgstr "Przeglądarka zablokowała dostęp do schowka, więc nie skopiowano tekstu."

#. %(zone)s is the viewer's time zone as their browser names it, e.g. "Central
