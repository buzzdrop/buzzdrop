#: app.py templates/_composer_strings.html templates/_users_strings.html
msgid "Too many requests. Please try again later."
msgstr "Zbyt wiele żądań. Spróbuj ponownie później."

#: app.py templates/_composer_strings.html
msgid "The server would not accept the drop. Please try again."
msgstr "Serwer nie przyjął przesyłki. Spróbuj ponownie."

#: app.py templates/_composer_strings.html templates/_dropzones_strings.html
msgid "Choose a valid expiry time."
msgstr "Wybierz poprawny termin ważności."

#: app.py templates/_composer_strings.html templates/_respond_strings.html
msgid "That file type is not allowed."
msgstr "Ten typ pliku jest niedozwolony."

#: app.py templates/_composer_strings.html
msgid "Could not send the drop. Please try again."
msgstr "Nie udało się wysłać przesyłki. Spróbuj ponownie."

#: app.py templates/_composer_strings.html
msgid "Open notifications are not configured on this server."
msgstr "Powiadomienia o otwarciu nie są skonfigurowane na tym serwerze."

#: app.py templates/_composer_strings.html
msgid "Configure an account email before enabling open notifications."
msgstr "Zanim włączysz powiadomienia o otwarciu, ustaw adres e-mail konta."

#: app.py templates/_composer_strings.html
msgid "Your configured account email is invalid."
msgstr "Adres e-mail ustawiony na koncie jest nieprawidłowy."

#: app.py templates/_composer_strings.html
msgid "Open notifications can only be sent to your configured account email."
msgstr ""
"Powiadomienia o otwarciu można wysyłać tylko na adres e-mail ustawiony na"
" koncie."

#: app.py templates/_view_strings.html
msgid "This drop has already been opened."
msgstr "Tę przesyłkę już otwarto."

#: app.py
msgid "Drop not found"
msgstr "Nie znaleziono przesyłki"

#: app.py
msgid "This drop has expired."
msgstr "Ta przesyłka wygasła."

#. Translators: the drop-opened email's "Decryption status" value.
#: app.py
msgctxt "decryption status"
msgid "successful"
msgstr "udane"

#. Translators: the drop-opened email's "Decryption status" value.
#: app.py
msgctxt "decryption status"
msgid "failed"
msgstr "nieudane"

#. Translators: the drop-opened email's "Decryption status" value: the
#. recipient's browser never said whether decryption worked.
#: app.py
msgctxt "decryption status"
msgid "not reported"
msgstr "nie zgłoszono"

#: app.py
msgid "Buzzdrop note opened"
msgstr "Buzzdrop: otwarto notatkę"

#: app.py
msgid "Buzzdrop file opened"
msgstr "Buzzdrop: otwarto plik"

#: app.py
msgid "Your drop was opened."
msgstr "Twoją przesyłkę otwarto."

#: app.py
#, python-format
msgid "Type: %(type)s"
msgstr "Typ: %(type)s"

#: app.py templates/_composer.html utils.py
msgid "Note"
msgstr "Notatka"

#: app.py templates/_composer.html
msgid "File"
msgstr "Plik"

#: app.py
#, python-format
msgid "Original name: %(name)s"
msgstr "Nazwa pliku: %(name)s"

#. Translators: %(time)s is when the drop was opened, e.g. "6 sty 2025, 21:35
#. CET".
#: app.py
#, python-format
msgid "Opened at: %(time)s"
msgstr "Otwarto: %(time)s"

#: app.py
#, python-format
msgid "Decryption status: %(status)s"
msgstr "Odszyfrowanie: %(status)s"

#: app.py
msgid ""
"Buzzdrop intentionally omits recipient-sensitive details from this "
"notification."
msgstr "Buzzdrop celowo pomija w tym powiadomieniu szczegóły dotyczące odbiorcy."

#: app.py
msgid "Buzzdrop submission received"
msgstr "Buzzdrop: nowe zgłoszenie"

#: app.py
msgid "A submission landed in your dropzone."
msgstr "Do twojej skrytki trafiło zgłoszenie."

#. Translators: %(time)s is when the submission landed.
#: app.py
#, python-format
msgid "Received at: %(time)s"
msgstr "Otrzymano: %(time)s"

#: app.py
msgid ""
"Buzzdrop intentionally omits responder-sensitive details from this "
"notification."
msgstr ""
"Buzzdrop celowo pomija w tym powiadomieniu szczegóły dotyczące "
"odpowiadającego."

#: app.py
msgid "Drop too large"
msgstr "Przesyłka jest za duża"

#: app.py
msgid "Page not found"
msgstr "Nie znaleziono strony"

#: app.py
msgid "There's nothing at this address."
msgstr "Pod tym adresem nic nie ma."

#: app.py
msgid "Something went wrong"
msgstr "Coś poszło nie tak"

#: app.py
msgid "The server hit an error. Please try again in a moment."
msgstr "Wystąpił błąd serwera. Spróbuj ponownie za chwilę."

#: app.py
msgid "Dead link"
msgstr "Nieaktywny link"

#: app.py
msgid "This drop is gone"
msgstr "Tej przesyłki już nie ma"

#: app.py
msgid "Ask the sender for a new one."
msgstr "Poproś nadawcę o nową."

#: app.py
msgid "Logged in successfully"
msgstr "Zalogowano"

#: app.py
msgid "Invalid username or password"
msgstr "Nieprawidłowa nazwa użytkownika lub hasło"

#: app.py
msgid "Invalid request"
msgstr "Nieprawidłowe żądanie"

#: app.py
msgid "Logged out successfully"
msgstr "Wylogowano"

#: app.py
msgid "API token not found"
msgstr "Nie znaleziono tokenu API"

#: app.py auth.py
msgid "Admin access required"
msgstr "Wymagany dostęp administratora"

#: app.py
msgid "API token revoked"
msgstr "Unieważniono token API"

#: app.py
msgid "No file part"
msgstr "W formularzu nie ma pliku"

#: app.py
msgid "No selected file"
msgstr "Nie wybrano pliku"

#: app.py
msgid "Drop deleted"
msgstr "Przesyłkę usunięto"

#: auth.py
msgid "Please log in to access this page"
msgstr "Zaloguj się, aby zobaczyć tę stronę"

#: utils.py
msgid "Active"
msgstr "Aktywna"

#: utils.py
msgid "Decrypted"
msgstr "Odszyfrowana"

#: templates/_dropzones_strings.html utils.py
msgid "Locked"
msgstr "Zablokowana"

#. Translators: a drop's status, also the label of when it was opened; it
#. agrees with "drop".
#: templates/index.html utils.py
msgid "Opened"
msgstr "Otwarta"

#: templates/_dropzones_strings.html utils.py
msgid "Expired"
msgstr "Wygasła"

#. the title of a note sent without a memo; %(time)s is when it was sent, e.g.
#. "21:35".
#: templates/_shared_files_strings.html utils.py
#, python-format
msgid "Note · %(time)s"
msgstr "Notatka · %(time)s"

#. a Copy button's label, flashed after a copy. Keep it short.
#: templates/_clipboard_feedback_strings.html
msgid "Copied!"
msgstr "Skopiowano!"

#. a Copy button's label, flashed when the browser refused the copy. Keep it
#. short.
#: templates/_clipboard_feedback_strings.html
msgid "Failed"
msgstr "Błąd"

#: templates/_clipboard_feedback_strings.html
msgid "Link copied to clipboard."
msgstr "Skopiowano link do schowka."

#: templates/_clipboard_feedback_strings.html
msgid "Your browser blocked clipboard access, so the link was not copied."
msgstr "Przeglądarka zablokowała dostęp do schowka, więc nie skopiowano linku."

#: templates/_clipboard_feedback_strings.html
msgid "Drop link copied to clipboard."
msgstr "Skopiowano do schowka link do przesyłki."

#: templates/_clipboard_feedback_strings.html
msgid "Your browser blocked clipboard access, so the drop link was not copied."
msgstr ""
"Przeglądarka zablokowała dostęp do schowka, więc nie skopiowano linku do "
"przesyłki."

#: templates/_clipboard_feedback_strings.html
msgid "One-click link copied to clipboard."
msgstr "Skopiowano link z hasłem do schowka."

#: templates/_clipboard_feedback_strings.html
msgid ""
"Your browser blocked clipboard access, so the one-click link was not "
"copied."
msgstr ""
"Przeglądarka zablokowała dostęp do schowka, więc nie skopiowano linku z "
"hasłem."

#: templates/_clipboard_feedback_strings.html
msgid "Password copied to clipboard."
msgstr "Skopiowano hasło do schowka."

#: templates/_clipboard_feedback_strings.html
msgid "Your browser blocked clipboard access, so the password was not copied."
msgstr "Przeglądarka zablokowała dostęp do schowka, więc nie skopiowano hasła."

#: templates/_clipboard_feedback_strings.html
msgid "Token copied to clipboard."
msgstr "Skopiowano token do schowka."

#: templates/_clipboard_feedback_strings.html
msgid "Your browser blocked clipboard access, so the token was not copied."
msgstr "Przeglądarka zablokowała dostęp do schowka, więc nie skopiowano tokenu."

#: templates/_clipboard_feedback_strings.html
msgid "Text copied to clipboard."
msgstr "Skopiowano tekst do schowka."

#: templates/_clipboard_feedback_strings.html
msgid "Your browser blocked clipboard access, so the text was not copied."
msgstr "Przeglądarka zablokowała dostęp do schowka, więc nie skopiowano tekstu."

#. the requester's wrong passwords locked the dropzone; the lock can't be
#. lifted.
#: templates/_collect_strings.html templates/collect.html
msgid "Too many incorrect passwords — this dropzone is locked."
msgstr "Za dużo nieprawidłowych haseł – skrytka zablokowana na stałe."

#: templates/_collect_strings.html templates/_view_strings.html
msgid "Checking password…"
msgstr "Sprawdzanie hasła…"

#: templates/_collect_strings.html templates/_view_strings.html
msgid "Getting key…"
msgstr "Pobieranie klucza…"

#: templates/_collect_strings.html templates/_view_strings.html
msgid "Downloading…"
msgstr "Pobieranie przesyłki…"

#: templates/_collect_strings.html templates/_view_strings.html
msgid "Decrypting…"
msgstr "Odszyfrowywanie…"

#: templates/_collect_strings.html
msgid "This dropzone uses an unsupported format."
msgstr "Ta skrytka ma nieobsługiwany format."

#: templates/_collect_strings.html templates/_view_strings.html
msgid "Text decrypted successfully."
msgstr "Odszyfrowano notatkę."

#: templates/_collect_strings.html templates/_view_strings.html
msgid "Download complete."
msgstr "Pobieranie zakończone."

#: templates/_collect_strings.html templates/_dropzones_strings.html
#: templates/_view_strings.html
msgid "Incorrect password."
msgstr "Nieprawidłowe hasło."

#: templates/_collect_strings.html templates/_dropzones_strings.html
#: templates/_view_strings.html
#, python-format
msgid "Incorrect password. %(count)s attempt remaining."
msgid_plural "Incorrect password. %(count)s attempts remaining."
msgstr[0] "Nieprawidłowe hasło. Została %(count)s próba."
msgstr[1] "Nieprawidłowe hasło. Zostały %(count)s próby."
msgstr[2] "Nieprawidłowe hasło. Zostało %(count)s prób."

#: templates/_collect_strings.html
#, python-format
msgid "One attempt left — check the password before you continue."
msgid_plural "%(count)s attempts left — check the password before you continue."
msgstr[0] "Została jedna próba – sprawdź hasło, zanim przejdziesz dalej."
msgstr[1] "Zostały %(count)s próby – sprawdź hasło, zanim przejdziesz dalej."
msgstr[2] "Zostało %(count)s prób – sprawdź hasło, zanim przejdziesz dalej."

#: templates/_collect_strings.html templates/_dropzones_strings.html
msgid "Nothing has been submitted to this dropzone yet."
msgstr "Do tej skrytki nic jeszcze nie złożono."

#: templates/_collect_strings.html templates/_dropzones_strings.html
#: templates/_respond_strings.html templates/_view_strings.html
msgid "Could not reach the server — check the connection and try again."
msgstr "Nie udało się połączyć z serwerem – sprawdź połączenie i spróbuj ponownie."

#: templates/_collect_strings.html templates/_dropzones_strings.html
#: templates/_respond_strings.html templates/_view_strings.html
msgid "Too many tries in a short time — wait a minute and try again."
msgstr "Zbyt wiele prób w krótkim czasie – odczekaj chwilę i spróbuj ponownie."

#: templates/_collect_strings.html templates/_dropzones_strings.html
msgid "This submission was already collected."
msgstr "To zgłoszenie już odebrano."

#: templates/_collect_strings.html
msgid "This dropzone is gone."
msgstr "Tej skrytki już nie ma."

#: templates/_collect_strings.html
msgid "The server refused to release this submission."
msgstr "Serwer odmówił wydania tego zgłoszenia."

#: templates/_collect_strings.html
msgid "The submission could not be decrypted — it may be corrupted."
msgstr "Nie udało się odszyfrować zgłoszenia — może być uszkodzone."

#: templates/_composer.html
msgid ""
"Drop a file here, or <span class=\"text-honey-300 underline decoration-"
"honey-400/40 underline-offset-4\">browse</span>"
msgstr ""
"Upuść tu plik albo <span class=\"text-honey-300 underline decoration-"
"honey-400/40 underline-offset-4\">wybierz go</span>"

#: templates/_composer.html
msgid "It is encrypted on this device before a single byte leaves it."
msgstr ""
"Zostanie zaszyfrowany na tym urządzeniu, zanim opuści je choćby jeden "
"bajt."

#: templates/_composer.html
#, python-format
msgid "Up to %(size)s"
msgstr "Do %(size)s"

#: templates/_composer.html
msgid "Your note"
msgstr "Treść notatki"

#: templates/_composer.html
msgid "Paste the note you want to protect with a one-time buzz…"
msgstr "Wklej notatkę, którą chcesz wysłać jednorazowo…"

#: templates/_composer.html
msgid "Encrypted in the browser before it reaches the server."
msgstr "Szyfrowana w przeglądarce, zanim dotrze do serwera."

#. %(zone)s is the viewer's time zone as their browser names it, e.g. "Central
#. European Time".
#: templates/_composer_strings.html
#, python-format
msgid "In your time zone (%(zone)s)."
msgstr "W twojej strefie czasowej (%(zone)s)."

#: templates/_composer_strings.html
msgid "Send file"
msgstr "Wyślij plik"

#: templates/_composer_strings.html
msgid "Send note"
msgstr "Wyślij notatkę"

#: templates/_composer_strings.html
msgid "Choose a file to send."
msgstr "Wybierz plik do wysłania."

#: templates/_composer_strings.html
msgid "Write the note you want to send."
msgstr "Napisz notatkę, którą chcesz wysłać."

#: templates/_composer_strings.html
msgid "Network error while sending the drop. Please try again."
msgstr "Błąd sieci podczas wysyłania przesyłki. Spróbuj ponownie."

#: templates/_composer_strings.html
msgid "The drop is too large to send."
msgstr "Przesyłka jest za duża, żeby ją wysłać."

#: templates/_composer_strings.html templates/_users_strings.html
msgid "Your session has expired. Reload the page and try again."
msgstr "Sesja wygasła. Odśwież stronę i spróbuj ponownie."

#: templates/_composer_strings.html
msgid "The drop may have been sent, but the server's reply could not be read."
msgstr ""
"Przesyłka mogła zostać wysłana, ale nie udało się odczytać odpowiedzi "
"serwera."

#: templates/_confirm_dialog.html
msgid "Cancel"
msgstr "Anuluj"

#: templates/_confirm_download_strings.html
msgid "This link already carries the key — continue and the drop goes BZZT."
msgstr "Ten link zawiera już hasło – przejdź dalej, a przesyłka zrobi BZZT."

#: templates/_dropzones_strings.html templates/index.html
msgid "Create dropzone"
msgstr "Utwórz skrytkę"

#: templates/_dropzones_strings.html
msgid "Creating…"
msgstr "Tworzenie…"

#: templates/_dropzones_strings.html
msgid ""
"Dropzone created — copy the request link now; it is never shown again. "
"The link carries the secret itself, so the server cannot recreate it."
msgstr ""
"Skrytka utworzona — skopiuj teraz link do niej, bo już się nie wyświetli."
" Link sam niesie sekret, więc serwer nie potrafi go odtworzyć."

#: templates/_dropzones_strings.html
msgid "Link lost? This dropzone is dead weight — delete it and create a new one."
msgstr "Zgubiłeś link? Ta skrytka to martwy ciężar — usuń ją i utwórz nową."

#: templates/_dropzones_strings.html templates/index.html
msgid "Copy request link"
msgstr "Skopiuj link do skrytki"

#: templates/_dropzones_strings.html
msgid "Copied."
msgstr "Skopiowano."

#: templates/_dropzones_strings.html templates/collect.html
msgid "Collect"
msgstr "Odbierz"

#: templates/_dropzones_strings.html
msgid "Collecting…"
msgstr "Odbieranie…"

#: templates/_dropzones_strings.html
msgid "Enter the dropzone password"
msgstr "Wpisz hasło do skrytki"

#: templates/_dropzones_strings.html
msgid "Enter the dropzone password first."
msgstr "Najpierw wpisz hasło do skrytki."

#: templates/_dropzones_strings.html
msgid "Awaiting submission"
msgstr "Oczekuje na zgłoszenie"

#: templates/_dropzones_strings.html
msgid "Submission ready"
msgstr "Zgłoszenie gotowe"

#: templates/_dropzones_strings.html
msgid "Collected"
msgstr "Odebrano"

#: templates/_dropzones_strings.html
msgid "file"
msgstr "plik"

#: templates/_dropzones_strings.html templates/users.html
msgid "Created"
msgstr "Utworzono"

#: templates/_dropzones_strings.html templates/index.html
msgid "Expiry"
msgstr "Termin ważności"

#: templates/_dropzones_strings.html
msgid "Submitted"
msgstr "Złożono"

#: templates/_dropzones_strings.html templates/index.html
msgid "From"
msgstr "Z adresu"

#: templates/_dropzones_strings.html templates/index.html
msgid "No expiry"
msgstr "Bez terminu"

#: templates/_dropzones_strings.html templates/_shared_files_strings.html
msgid "Not yet"
msgstr "Jeszcze nie"

#: templates/_dropzones_strings.html
msgid "note"
msgstr "notatka"

#: templates/_dropzones_strings.html templates/index.html
msgid "Delete"
msgstr "Usuń"

#: templates/_dropzones_strings.html
msgid "Delete this dropzone?"
msgstr "Usunąć tę skrytkę?"

#: templates/_dropzones_strings.html
msgid "Could not create the dropzone. Please try again."
msgstr "Nie udało się utworzyć skrytki. Spróbuj ponownie."

#: templates/_dropzones_strings.html
msgid "This dropzone has expired."
msgstr "Ta skrytka wygasła."

#: templates/_dropzones_strings.html
msgid "Could not download the submission."
msgstr "Nie udało się pobrać zgłoszenia."

#. the language menu button's name; %(language)s is the current language in
#. itself, e.g. "Polski".
#: templates/_language_menu.html
#, python-format
msgid "Language: %(language)s"
msgstr "Język: %(language)s"

#. %(reason)s is one of the strength messages, e.g. "Too weak (~30 bits). …".
#: templates/_password_gate_strings.html
#, python-format
msgid "Password rejected: %(reason)s"
msgstr "Hasło odrzucone: %(reason)s"

#: templates/_password_gate_strings.html
msgid "Weak"
msgstr "Słabe"

#: templates/_password_gate_strings.html
msgid "Fair"
msgstr "Wystarczające"

#: templates/_password_gate_strings.html
msgid "Strong"
msgstr "Silne"

#: templates/_password_gate_strings.html
msgid "That password is on every cracker list ever published."
msgstr "To hasło jest na każdej opublikowanej liście haseł do łamania."

#: templates/_password_gate_strings.html
#, python-format
msgid "Too weak (~%(bits)s bits). Use Generate or a longer passphrase."
msgstr ""
"Za słabe (bity entropii: ~%(bits)s). Użyj „Wygeneruj” albo dłuższego "
"hasła ze słów."

#: templates/_password_gate_strings.html
#, python-format
msgid "Acceptable (~%(bits)s bits) — a generated 6-word passphrase is stronger."
msgstr ""
"Wystarczające (bity entropii: ~%(bits)s) – wygenerowane hasło z 6 słów "
"jest silniejsze."

#: templates/_password_gate_strings.html
#, python-format
msgid "Strong (~%(bits)s bits)."
msgstr "Silne (bity entropii: ~%(bits)s)."

#: templates/_password_gate_strings.html templates/_success_strings.html
msgid "Show"
msgstr "Pokaż"

#: templates/_password_gate_strings.html templates/_success_strings.html
msgid "Hide"
msgstr "Ukryj"

#: templates/_password_gate_strings.html templates/_success_strings.html
msgid "Show password"
msgstr "Pokaż hasło"

#: templates/_password_gate_strings.html
msgid "Enter a password, or press Generate."
msgstr "Wpisz hasło albo naciśnij „Wygeneruj”."

#: templates/_respond_strings.html
msgid "Choose a file to submit."
msgstr "Wybierz plik do złożenia."

#: templates/_respond_strings.html
msgid "Write the note to submit."
msgstr "Napisz notatkę do złożenia."

#: templates/_respond_strings.html
msgid "That file is too large for this server."
msgstr "Ten plik jest za duży dla tego serwera."

#: templates/_respond_strings.html
msgid "That note is too large for this server."
msgstr "Ta notatka jest za duża dla tego serwera."

#: templates/_respond_strings.html
msgid "Submit"
msgstr "Złóż"

#: templates/_respond_strings.html
msgid "Encrypting…"
msgstr "Szyfrowanie…"

#: templates/_respond_strings.html
msgid ""
"Encryption failed — this browser may not support it. Try a modern browser"
" or a secure (https) connection."
msgstr ""
"Nie udało się zaszyfrować — ta przeglądarka może tego nie wspierać. "
"Spróbuj w nowoczesnej przeglądarce albo przez bezpieczne połączenie "
"(https)."

#: templates/_respond_strings.html
msgid "Submitting…"
msgstr "Składanie…"

#: templates/_respond_strings.html
msgid "Submitted — the requester can now collect it. You can close this page."
msgstr ""
"Złożono – zamawiający może teraz odebrać zgłoszenie. Możesz zamknąć tę "
"stronę."

#: templates/_respond_strings.html
msgid ""
"This request link is not valid — check that the whole link was copied, "
"including the part after #."
msgstr ""
"Ten link do skrytki jest nieprawidłowy – sprawdź, czy skopiowano cały "
"link, wraz z częścią po #."

#: templates/_respond_strings.html
msgid "This dropzone is gone. Ask the requester for a new link."
msgstr "Tej skrytki już nie ma. Poproś zamawiającego o nowy link."

#: templates/_respond_strings.html
msgid "This request link was already used. Ask the requester for a new one."
msgstr "Tego linku do skrytki już użyto. Poproś zamawiającego o nowy."

#: templates/_respond_strings.html
msgid "This dropzone has expired. Ask the requester for a new link."
msgstr "Ta skrytka wygasła. Poproś zamawiającego o nowy link."

#: templates/_respond_strings.html
msgid "The submission was refused. Please try again."
msgstr "Zgłoszenie odrzucono. Spróbuj ponownie."

#: templates/_respond_strings.html
msgid "The submission failed. Please try again."
msgstr "Zgłoszenie nie powiodło się. Spróbuj ponownie."

#. a Copy link button's accessible name; %(name)s is the drop's title.
#: templates/_shared_files_strings.html
#, python-format
msgid "Copy link for %(name)s"
msgstr "Skopiuj link: %(name)s"

#: templates/_shared_files_strings.html
msgid "No matching drops"
msgstr "Brak pasujących przesyłek"

#: templates/_shared_files_strings.html
#, python-format
msgid "Page %(page)s of %(total)s"
msgstr "Strona %(page)s z %(total)s"

#: templates/_shared_files_strings.html
