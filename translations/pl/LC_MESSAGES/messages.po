msgid "Choose a file to send."
msgstr "Wybierz plik do wysłania."

#: templates/_composer_strings.html
msgid "Write the note you want to send."
msgstr "Napisz notatkę, którą chcesz wysłać."

#: templates/_composer_strings.html
msgid "Network error while sending the drop. Please try again."
msgstr "Błąd sieci podczas wysyłania przesyłki. Spróbuj ponownie."

#: templates/_composer_strings.html
msgid "The drop is too large to send."
msgstr "Przesyłka jest za duża, żeby ją wysłać."

#: templates/_composer_strings.html templates/_users_strings.html
msgid "Your session has expired. Reload the page and try again."
msgstr "Sesja wygasła. Odśwież stronę i spróbuj ponownie."

#: templates/_composer_strings.html
msgid "The drop may have been sent, but the server's reply could not be read."
msgstr ""
"Przesyłka mogła zostać wysłana, ale nie udało się odczytać odpowiedzi "
"serwera."

#: templates/_confirm_download_strings.html
msgid "This link already carries the key — continue and the drop goes BZZT."
msgstr "Ten link zawiera już hasło – przejdź dalej, a przesyłka zrobi BZZT."

