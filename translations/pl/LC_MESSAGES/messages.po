msgstr "Wystąpił błąd serwera. Spróbuj ponownie za chwilę."

#: app.py
msgid "Dead link"
msgstr "Nieaktywny link"

#: app.py
msgid "This drop is gone"
msgstr "Tej przesyłki już nie ma"

#: app.py
msgid "Ask the sender for a new one."
msgstr "Poproś nadawcę o nową."

#: app.py
msgid "Logged in successfully"
msgstr "Zalogowano"

#: app.py
