msgstr "Nie znaleziono tokenu API"

#: app.py auth.py
msgid "Admin access required"
msgstr "Wymagany dostęp administratora"

#: app.py
msgid "API token revoked"
msgstr "Unieważniono token API"

#: app.py
msgid "No file part"
msgstr "W formularzu nie ma pliku"

#: app.py
msgid "No selected file"
msgstr "Nie wybrano pliku"

#: app.py
msgid "Drop not found"
msgstr "Nie znaleziono przesyłki"

#: app.py
msgid "Drop deleted"
msgstr "Przesyłkę usunięto"

#: auth.py
msgid "Please log in to access this page"
msgstr "Zaloguj się, aby zobaczyć tę stronę"

#: utils.py
msgid "Active"
msgstr "Aktywna"

#: utils.py
msgid "Decrypted"
msgstr "Odszyfrowana"

#: utils.py
msgid "Locked"
msgstr "Zablokowana"

#. Translators: a drop's status, also the label of when it was opened; it
#. agrees with "drop".
#: templates/index.html utils.py
msgid "Opened"
msgstr "Otwarta"

#: utils.py
msgid "Expired"
msgstr "Wygasła"

#. the title of a note sent without a memo; %(time)s is when it was sent, e.g.
#. "21:35".
#: templates/_shared_files_strings.html utils.py
#, python-format
msgid "Note · %(time)s"
msgstr "Notatka · %(time)s"

#: templates/index.html utils.py
msgid "Note"
msgstr "Notatka"

#. a Copy button's label, flashed after a copy. Keep it short.
#: templates/_clipboard_feedback_strings.html
msgid "Copied!"
msgstr "Skopiowano!"

#. a Copy button's label, flashed when the browser refused the copy. Keep it
#. short.
#: templates/_clipboard_feedback_strings.html
msgid "Failed"
msgstr "Błąd"

#: templates/_clipboard_feedback_strings.html
msgid "Link copied to clipboard."
msgstr "Skopiowano link do schowka."

#: templates/_clipboard_feedback_strings.html
msgid "Your browser blocked clipboard access, so the link was not copied."
msgstr "Przeglądarka zablokowała dostęp do schowka, więc nie skopiowano linku."

#: templates/_clipboard_feedback_strings.html
msgid "Drop link copied to clipboard."
msgstr "Skopiowano do schowka link do przesyłki."

#: templates/_clipboard_feedback_strings.html
msgid "Your browser blocked clipboard access, so the drop link was not copied."
msgstr ""
"Przeglądarka zablokowała dostęp do schowka, więc nie skopiowano linku do "
"przesyłki."

#: templates/_clipboard_feedback_strings.html
msgid "One-click link copied to clipboard."
msgstr "Skopiowano link z hasłem do schowka."

#: templates/_clipboard_feedback_strings.html
msgid ""
"Your browser blocked clipboard access, so the one-click link was not "
"copied."
msgstr ""
"Przeglądarka zablokowała dostęp do schowka, więc nie skopiowano linku z "
"hasłem."

#: templates/_clipboard_feedback_strings.html
msgid "Password copied to clipboard."
msgstr "Skopiowano hasło do schowka."

#: templates/_clipboard_feedback_strings.html
msgid "Your browser blocked clipboard access, so the password was not copied."
msgstr "Przeglądarka zablokowała dostęp do schowka, więc nie skopiowano hasła."

#: templates/_clipboard_feedback_strings.html
msgid "Token copied to clipboard."
msgstr "Skopiowano token do schowka."

#: templates/_clipboard_feedback_strings.html
msgid "Your browser blocked clipboard access, so the token was not copied."
msgstr "Przeglądarka zablokowała dostęp do schowka, więc nie skopiowano tokenu."

#: templates/_clipboard_feedback_strings.html
msgid "Text copied to clipboard."
msgstr "Skopiowano tekst do schowka."

#: templates/_clipboard_feedback_strings.html
msgid "Your browser blocked clipboard access, so the text was not copied."
msgstr "Przeglądarka zablokowała dostęp do schowka, więc nie skopiowano tekstu."

#. %(zone)s is the viewer's time zone as their browser names it, e.g. "Central
#. European Time".
#: templates/_composer_strings.html
#, python-format
msgid "In your time zone (%(zone)s)."
msgstr "W twojej strefie czasowej (%(zone)s)."

#: templates/_composer_strings.html
msgid "Send file"
msgstr "Wyślij plik"

#: templates/_composer_strings.html
msgid "Send note"
msgstr "Wyślij notatkę"

#: templates/_composer_strings.html
msgid "Choose a file to send."
msgstr "Wybierz plik do wysłania."

#: templates/_composer_strings.html
msgid "Write the note you want to send."
msgstr "Napisz notatkę, którą chcesz wysłać."

#: templates/_composer_strings.html
msgid "Network error while sending the drop. Please try again."
msgstr "Błąd sieci podczas wysyłania przesyłki. Spróbuj ponownie."

#: templates/_composer_strings.html
msgid "The drop is too large to send."
msgstr "Przesyłka jest za duża, żeby ją wysłać."

#: templates/_composer_strings.html templates/_users_strings.html
msgid "Your session has expired. Reload the page and try again."
msgstr "Sesja wygasła. Odśwież stronę i spróbuj ponownie."

#: templates/_composer_strings.html
msgid "The drop may have been sent, but the server's reply could not be read."
msgstr ""
"Przesyłka mogła zostać wysłana, ale nie udało się odczytać odpowiedzi "
"serwera."

#: templates/_confirm_download_strings.html
msgid "This link already carries the key — continue and the drop goes BZZT."
msgstr "Ten link zawiera już hasło – przejdź dalej, a przesyłka zrobi BZZT."

#: templates/_hero_flow_strings.html
msgid "Play walkthrough"
msgstr "Odtwórz przykład"

#: templates/_hero_flow_strings.html
msgid "Pause walkthrough"
msgstr "Wstrzymaj przykład"

#. the language menu button's name; %(language)s is the current language in
#. itself, e.g. "Polski".
#: templates/_language_menu.html
#, python-format
msgid "Language: %(language)s"
msgstr "Język: %(language)s"

#. %(reason)s is one of the strength messages, e.g. "Too weak (~30 bits). …".
#: templates/_password_gate_strings.html
#, python-format
msgid "Password rejected: %(reason)s"
msgstr "Hasło odrzucone: %(reason)s"

#: templates/_password_gate_strings.html
msgid "Weak"
msgstr "Słabe"

#: templates/_password_gate_strings.html
msgid "Fair"
msgstr "Wystarczające"

#: templates/_password_gate_strings.html
msgid "Strong"
msgstr "Silne"

#: templates/_password_gate_strings.html
msgid "That password is on every cracker list ever published."
msgstr "To hasło jest na każdej opublikowanej liście haseł do łamania."

#: templates/_password_gate_strings.html
#, python-format
msgid "Too weak (~%(bits)s bits). Use Generate or a longer passphrase."
msgstr ""
"Za słabe (bity entropii: ~%(bits)s). Użyj „Wygeneruj” albo dłuższego "
"hasła ze słów."

#: templates/_password_gate_strings.html
#, python-format
msgid "Acceptable (~%(bits)s bits) — a generated 6-word passphrase is stronger."
msgstr ""
"Wystarczające (bity entropii: ~%(bits)s) – wygenerowane hasło z 6 słów "
"jest silniejsze."

#: templates/_password_gate_strings.html
#, python-format
msgid "Strong (~%(bits)s bits)."
msgstr "Silne (bity entropii: ~%(bits)s)."

#: templates/_password_gate_strings.html templates/_success_strings.html
msgid "Show"
msgstr "Pokaż"

#: templates/_password_gate_strings.html templates/_success_strings.html
msgid "Hide"
msgstr "Ukryj"

#: templates/_password_gate_strings.html templates/_success_strings.html
msgid "Show password"
msgstr "Pokaż hasło"

#: templates/_password_gate_strings.html
msgid "Enter a password, or press Generate."
msgstr "Wpisz hasło albo naciśnij „Wygeneruj”."

#. a Copy link button's accessible name; %(name)s is the drop's title.
#: templates/_shared_files_strings.html
#, python-format
msgid "Copy link for %(name)s"
msgstr "Skopiuj link: %(name)s"

#: templates/_shared_files_strings.html
msgid "Not yet"
msgstr "Jeszcze nie"

#: templates/_shared_files_strings.html
msgid "No matching drops"
msgstr "Brak pasujących przesyłek"

#: templates/_shared_files_strings.html
#, python-format
msgid "Page %(page)s of %(total)s"
msgstr "Strona %(page)s z %(total)s"

#: templates/_shared_files_strings.html
#, python-format
msgid "Showing %(first)s–%(last)s of %(count)s drop"
msgid_plural "Showing %(first)s–%(last)s of %(count)s drops"
msgstr[0] "Pokazano %(first)s–%(last)s, łącznie %(count)s przesyłka"
msgstr[1] "Pokazano %(first)s–%(last)s, łącznie %(count)s przesyłki"
msgstr[2] "Pokazano %(first)s–%(last)s, łącznie %(count)s przesyłek"

#. shown under a new API token; %(time)s is when it expires, in the viewer's
#. zone, e.g. "Dec 31, 2098, 19:00 CET".
#: templates/_users_strings.html
#, python-format
msgid "Expires %(time)s. Reload to see it in the list below."
msgstr "Wygasa %(time)s. Odśwież stronę, by zobaczyć go na liście poniżej."

#: templates/_users_strings.html
msgid "Only an admin can generate a token for another user."
msgstr "Token dla innego użytkownika może wygenerować tylko administrator."

#: templates/_users_strings.html
msgid "That user no longer exists."
msgstr "Ten użytkownik już nie istnieje."

#: templates/_users_strings.html
msgid "Could not generate a token. Please try again."
msgstr "Nie udało się wygenerować tokenu. Spróbuj ponownie."

#. the recipient's wrong passwords locked the drop; the lock can't be lifted.
#: templates/_view_strings.html
msgid "Too many incorrect passwords — this drop is locked."
msgstr "Za dużo nieprawidłowych haseł – przesyłka zablokowana na stałe."

#: templates/_view_strings.html
msgid "Checking password…"
msgstr "Sprawdzanie hasła…"

#: templates/_view_strings.html
msgid "Getting key…"
msgstr "Pobieranie klucza…"

#: templates/_view_strings.html
msgid "Downloading…"
msgstr "Pobieranie przesyłki…"

#: templates/_view_strings.html
msgid "Decrypting…"
msgstr "Odszyfrowywanie…"

#: templates/_view_strings.html
msgid "This drop uses an unsupported format. Ask the sender to send it again."
msgstr "Ta przesyłka ma nieobsługiwany format. Poproś nadawcę o ponowne wysłanie."

#: templates/_view_strings.html
msgid "Text decrypted successfully."
msgstr "Odszyfrowano notatkę."

#: templates/_view_strings.html
msgid "Download complete."
msgstr "Pobieranie zakończone."

#: templates/_view_strings.html
msgid "Incorrect password."
msgstr "Nieprawidłowe hasło."

#: templates/_view_strings.html
#, python-format
msgid "Incorrect password. %(count)s attempt remaining."
msgid_plural "Incorrect password. %(count)s attempts remaining."
msgstr[0] "Nieprawidłowe hasło. Została %(count)s próba."
msgstr[1] "Nieprawidłowe hasło. Zostały %(count)s próby."
msgstr[2] "Nieprawidłowe hasło. Zostało %(count)s prób."

#: templates/_view_strings.html
msgid "Could not reach the server — check the connection and try again."
msgstr "Nie udało się połączyć z serwerem – sprawdź połączenie i spróbuj ponownie."

#: templates/_view_strings.html
msgid "Too many tries in a short time — wait a minute and try again."
msgstr "Zbyt wiele prób w krótkim czasie – odczekaj chwilę i spróbuj ponownie."

#: templates/_view_strings.html
msgid "This drop has already been opened."
msgstr "Tę przesyłkę już otwarto."

#: templates/_view_strings.html
msgid "This drop is gone. Ask the sender for a new one."
msgstr "Tej przesyłki już nie ma. Poproś nadawcę o nową."

#: templates/_view_strings.html
msgid "The server refused to open this drop."
msgstr "Serwer odmówił otwarcia tej przesyłki."

#: templates/_view_strings.html
msgid "Incorrect password or corrupted drop. Ask the sender to send it again."
msgstr ""
"Nieprawidłowe hasło albo uszkodzona przesyłka. Poproś nadawcę o ponowne "
"wysłanie."

#: templates/base.html
msgid ""
"Buzzdrop: secure, one-time file sharing. Encrypt files or notes, send a "
"link, and let them vanish as soon as the recipient downloads them."
msgstr ""
"Buzzdrop: bezpieczne, jednorazowe przesyłanie plików. Wyślij zaszyfrowany"
" plik albo notatkę, przekaż link i pozwól im zniknąć, gdy tylko odbiorca "
"je pobierze."

#: templates/base.html
msgid "Buzzdrop: Secure, One-Time File Sharing"
msgstr "Buzzdrop: bezpieczne, jednorazowe przesyłanie plików"

#: templates/base.html templates/index.html
msgid "One-time buzz"
msgstr "Przesyłka jednorazowa"

#: templates/base.html
msgid "Manage Users"
msgstr "Użytkownicy"

#: templates/base.html
msgid "Logout"
msgstr "Wyloguj"

#: templates/base.html templates/login.html
msgid "Login"
msgstr "Zaloguj"

#: templates/base.html
msgid "Each drop opens once, then it's gone."
msgstr "Każdą przesyłkę można otworzyć raz, potem znika."

#: templates/base.html templates/confirm_download.html templates/view.html
msgid "How it works (opens in new tab)"
msgstr "Jak to działa (otwiera się w nowej karcie)"

#: templates/base.html templates/confirm_download.html templates/view.html
msgid "How it works"
msgstr "Jak to działa"

#: templates/base.html
msgid "Built in the open."
msgstr "Tworzony jawnie."

#: templates/base.html
msgid "Source code (opens in new tab)"
msgstr "Kod źródłowy (otwiera się w nowej karcie)"

#: templates/base.html
msgid "Source code"
msgstr "Kod źródłowy"

#: templates/base.html
msgid "AGPL-3.0 licence text (opens in new tab)"
msgstr "Tekst licencji AGPL-3.0 (otwiera się w nowej karcie)"

#: templates/confirm_download.html
msgid "One-time action"
msgstr "Jednorazowe otwarcie"

#: templates/confirm_download.html
msgid "Ready to view?"
msgstr "Otworzyć notatkę?"

#: templates/confirm_download.html
msgid "Ready to download?"
msgstr "Pobrać plik?"

#: templates/confirm_download.html
msgid "A secret note is waiting — its name is inside the encryption."
msgstr "Czeka na ciebie notatka – jej nazwa też jest zaszyfrowana."

#: templates/confirm_download.html
msgid "A shared file is waiting — its name is inside the encryption."
msgstr "Czeka na ciebie plik – jego nazwa też jest zaszyfrowana."

#: templates/confirm_download.html
msgid "This note can be opened once."
msgstr "Tę notatkę można otworzyć tylko raz."

#: templates/confirm_download.html
msgid "This file can be opened once."
msgstr "Ten plik można otworzyć tylko raz."

#: templates/confirm_download.html
msgid ""
"The first correct password claims it — after that it's gone for everyone."
" If the sender shared the password separately, have it ready."
msgstr ""
"Pierwsze poprawne hasło otwiera przesyłkę – potem nie ma jej już dla "
"nikogo. Jeśli hasło dostajesz osobno, przygotuj je."

#: templates/confirm_download.html
msgid "Proceed to view"
msgstr "Przejdź do notatki"

#: templates/confirm_download.html
msgid "Proceed to download"
msgstr "Przejdź do pobierania"

#: templates/confirm_download.html
msgid "Curious what happens next, and what we can see?"
msgstr "Ciekawi cię, co będzie dalej i co widzimy?"

#: templates/error.html
msgid "Go to Buzzdrop"
msgstr "Przejdź do Buzzdropa"

#: templates/index.html templates/success.html
msgid "Send the link and the password through different channels."
msgstr "Wyślij link i hasło różnymi kanałami."

#: templates/index.html
msgid "Secure handoff"
msgstr "Bezpieczne przekazanie"

#: templates/index.html
msgid "Make it <span class=\"honey-text\">buzz</span>, then vanish."
msgstr "Niech <span class=\"honey-text\">zabzyczy</span>, a potem zniknie."

#: templates/index.html
msgid ""
"<strong>Encrypt a file or a note in your browser</strong>, send one link,"
" and let the drop delete itself the moment it is downloaded. The contents"
" are ciphertext to the server; details like the filename and your memo "
"are not."
msgstr ""
"<strong>Zaszyfruj plik albo notatkę w przeglądarce</strong>, wyślij jeden"
" link, a przesyłka usunie się sama, gdy tylko zostanie pobrana. Dla "
"serwera treść to szyfrogram; szczegóły takie jak nazwa pliku czy twój "
"dopisek – już nie."

#: templates/index.html
msgid "What are you sending?"
msgstr "Co wysyłasz?"

#: templates/index.html
msgid "File"
msgstr "Plik"

#: templates/index.html
msgid ""
"Drop a file here, or <span class=\"text-honey-300 underline decoration-"
"honey-400/40 underline-offset-4\">browse</span>"
msgstr ""
"Upuść tu plik albo <span class=\"text-honey-300 underline decoration-"
"honey-400/40 underline-offset-4\">wybierz go</span>"

#: templates/index.html
msgid "It is encrypted on this device before a single byte leaves it."
msgstr ""
"Zostanie zaszyfrowany na tym urządzeniu, zanim opuści je choćby jeden "
"bajt."

#: templates/index.html
#, python-format
msgid "Up to %(size)s"
msgstr "Do %(size)s"

#: templates/index.html
msgid "Your note"
msgstr "Treść notatki"

#: templates/index.html
msgid "Paste the note you want to protect with a one-time buzz…"
msgstr "Wklej notatkę, którą chcesz wysłać jednorazowo…"

#: templates/index.html
msgid "Encrypted in the browser before it reaches the server."
msgstr "Szyfrowana w przeglądarce, zanim dotrze do serwera."

#: templates/index.html templates/login.html templates/success.html
#: templates/view.html
msgid "Password"
msgstr "Hasło"

#: templates/index.html
msgid "Enter a strong password"
msgstr "Wpisz silne hasło"

#: templates/index.html
msgid "Generate a 6-word passphrase (about 77 bits of entropy)"
msgstr "Wygeneruj hasło z 6 słów (ok. 77 bitów entropii)"

#: templates/index.html
msgid "Generate"
msgstr "Wygeneruj"

#: templates/index.html templates/success.html
msgid "Copy password"
msgstr "Skopiuj hasło"

#: templates/index.html templates/success.html templates/users.html
#: templates/view.html
msgid "Copy"
msgstr "Skopiuj"

#: templates/index.html
msgid "Password strength"
msgstr "Siła hasła"

#: templates/index.html
msgid "Send it through a different channel than the link."
msgstr "Przekaż je innym kanałem niż link."

#: templates/index.html
msgid "Password clipboard"
msgstr "Schowek – hasło"

#: templates/index.html
msgid "Expiry date <span class=\"text-slate-600\">(optional)</span>"
msgstr "Termin ważności <span class=\"text-slate-600\">(opcjonalnie)</span>"

#: templates/index.html
msgid "Leave empty to keep the drop until it’s opened."
msgstr "Zostaw puste, a przesyłka poczeka, aż ktoś ją otworzy."

#: templates/index.html
msgid "Memo <span class=\"text-slate-600\">(optional)</span>"
msgstr "Dopisek <span class=\"text-slate-600\">(opcjonalnie)</span>"

#: templates/index.html
msgid "A reminder in your drop list"
msgstr "Przypomnienie na twojej liście przesyłek"

#: templates/index.html
msgid "Only you see it. It isn’t encrypted."
msgstr "Widzisz go tylko ty. Nie jest szyfrowany."

#: templates/index.html
msgid "Notify me when this is opened"
msgstr "Powiadom mnie, gdy przesyłka zostanie otwarta"

#: templates/index.html
msgid ""
"One email once the recipient decrypts it. Delivery failures are logged "
"only."
msgstr ""
"Jeden e-mail, gdy odbiorca ją odszyfruje. Błędy doręczenia trafiają tylko"
" do logów."

#: templates/index.html
msgid "Account email"
msgstr "E-mail konta"

#: templates/index.html
msgid "Open notifications are sent only to this account email."
msgstr "Powiadomienia o otwarciu trafiają tylko na ten adres e-mail konta."

#: templates/index.html
msgid "Notifications need an email on your account — ask your admin."
msgstr ""
"Powiadomienia wymagają adresu e-mail na koncie – poproś o niego "
"administratora."

#: templates/index.html
msgid ""
"Stored as ciphertext only, destroyed the moment the recipient downloads "
"it."
msgstr ""
"Przechowywana tylko jako szyfrogram, niszczona w chwili, gdy odbiorca ją "
"pobierze."

#: templates/index.html
msgid "Sending progress"
msgstr "Postęp wysyłania"

#: templates/index.html
msgid ""
"File sharing that stings&nbsp;— <span class=\"honey-text\">just "
"once.</span>"
msgstr ""
