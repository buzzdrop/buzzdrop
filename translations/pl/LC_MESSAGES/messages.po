#: app.py templates/_composer_strings.html
msgid "Too many requests. Please try again later."
msgstr "Zbyt wiele żądań. Spróbuj ponownie później."

#: app.py
msgid "Open notifications are not configured on this server"
msgstr "Powiadomienia o otwarciu nie są skonfigurowane na tym serwerze"

#: app.py
msgid "Configure an account email before enabling open notifications"
msgstr "Zanim włączysz powiadomienia o otwarciu, ustaw adres e-mail konta"

#: app.py
msgid "Your configured account email is invalid"
msgstr "Adres e-mail ustawiony na koncie jest nieprawidłowy"

#: app.py
msgid "Open notifications can only be sent to your configured account email"
msgstr ""
"Powiadomienia o otwarciu można wysyłać tylko na adres e-mail ustawiony na"
" koncie"

#: app.py
msgid "Drop too large"
msgstr "Przesyłka jest za duża"

#: app.py
msgid "Page not found"
msgstr "Nie znaleziono strony"

#: app.py
msgid "There's nothing at this address."
msgstr "Pod tym adresem nic nie ma."

#: app.py
msgid "Something went wrong"
msgstr "Coś poszło nie tak"

#: app.py
msgid "The server hit an error. Please try again in a moment."
msgstr "Wystąpił błąd serwera. Spróbuj ponownie za chwilę."

#: app.py
msgid "Dead link"
msgstr "Nieaktywny link"

#: app.py
msgid "This drop is gone"
msgstr "Tej przesyłki już nie ma"

#: app.py
msgid ""
"It was already opened, it expired, or it never existed. Ask the sender "
"for a new one."
msgstr ""
"Została już otwarta, wygasła albo nigdy nie istniała. Poproś nadawcę o "
"nową."

#: app.py
msgid "Logged in successfully"
msgstr "Zalogowano"

#: app.py
msgid "Invalid username or password"
msgstr "Nieprawidłowa nazwa użytkownika lub hasło"

#: app.py
msgid "Invalid request"
msgstr "Nieprawidłowe żądanie"

#: app.py
msgid "Logged out successfully"
msgstr "Wylogowano"

#: app.py
msgid "Invalid key-release upload"
msgstr "Nieprawidłowe wysyłanie przesyłki"

#: app.py
msgid "Unknown or already finalized key-release upload"
msgstr "Nieznane albo już zakończone wysyłanie przesyłki"

#: app.py
msgid "Key-release share belongs to another user"
msgstr "Ta przesyłka należy do innego użytkownika"

#: app.py
msgid ""
"Expiry must be an ISO 8601 time with a time zone, e.g. "
"2026-12-31T23:59+01:00"
msgstr ""
"Termin ważności musi być czasem ISO 8601 ze strefą czasową, np. "
"2026-12-31T23:59+01:00"

#: app.py
msgid "Key-release upload was finalized elsewhere"
msgstr "Wysyłanie tej przesyłki zakończono gdzie indziej"

#: app.py
msgid "Upload failed"
msgstr "Nie udało się wysłać przesyłki"

#: app.py
msgid "No file part"
msgstr "W formularzu nie ma pliku"

#: app.py
msgid "No selected file"
msgstr "Nie wybrano pliku"

#: app.py
msgid "File type not allowed"
msgstr "Niedozwolony typ pliku"

#. a Copy button's label, flashed after a copy. Keep it short.
#: templates/_clipboard_feedback_strings.html
msgid "Copied!"
msgstr "Skopiowano!"

#. a Copy button's label, flashed when the browser refused the copy. Keep it
#. short.
