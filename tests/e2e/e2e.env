# E2E test profile for the app container (docs/frontend-test-strategy.md §8).
# Passed to `docker run --env-file` by playwright.config.js. Every variable
# the run relies on is set here, so nothing falls back to a developer's
# environment or to defaults that may change.

# HTTP cookies; limiter on with relaxed limits (all E2E traffic is one IP).
FLASK_ENV=testing

# The users the journeys log in as: one regular user, and one admin for
# the admin header and the users page (#299). tests/e2e/support.js carries
# the same credentials (USER, ADMIN).
FLASK_USER_1=e2e:e2e-login-password:false
FLASK_USER_2=e2e-admin:e2e-admin-login-password:true
# The API-token journey's token holders, one per browser project, as the
# three browsers run it at once (tokenHolder in tests/e2e/support.js).
FLASK_USER_3=e2e-token-chromium:e2e-token-login-password:false
FLASK_USER_4=e2e-token-firefox:e2e-token-login-password:false
FLASK_USER_5=e2e-token-webkit:e2e-token-login-password:false

# Fixed dummy: deterministic, and no temporary-key warning.
FLASK_SECRET_KEY=e2e-dummy-secret-key-not-for-production

# No mounts: all state lives in the container and goes with --rm.
# The app creates /tmp/e2e for both.
STORAGE_BACKEND=local
DATABASE_URL=sqlite:////tmp/e2e/buzzdrop.db
UPLOAD_FOLDER=/tmp/e2e/uploads

# The journeys upload .txt files.
ALLOWED_EXTENSIONS=txt,pdf,png,jpg,jpeg,gif,doc,docx,xls,xlsx

# Expiry is checked when a link is opened; no background sweeps.
EXPIRY_SWEEP_INTERVAL_SECONDS=0

# A server clock that is neither UTC nor Warsaw, and not the browser's
# zone either (playwright.config.js), so a time stored or compared in the
# host's zone fails a journey (#250). The image carries tzdata for it.
TZ=America/New_York

# No notification mail. SMTP_PORT keeps its default: it is parsed as an
# int, so an empty value would stop the app at startup.
SMTP_HOST=
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=

# Lockout keeps its defaults (KEY_RELEASE_MAX_ATTEMPTS=1, burn on), so the
# wrong-password journey tests it for real.

# Languages (#268): the journeys run in English. The browsers ask for
# en-US (playwright.config.js); a Polish journey asks for pl itself.
DEFAULT_LANGUAGE=en
LANGUAGES=en,pl
